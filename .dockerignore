# Keep the build context tiny + never bake secrets or local state into layers.
# NOTE: deploy/ is deliberately IN the context — deploy/Dockerfile.app copies
# deploy/entrypoint.app.sh (+ the optional deploy/data-sync app hook) into the
# runtime image. It is a few KB of scripts/config, never secrets.
node_modules
.next
.git
.claude
docs
scripts
DEPLOY.md

# local env + databases — the production DB lives on the /data volume
.env
.env.*
!.env.production.example
*.db
*.db-journal
prisma/dev.db
prisma/dev.db-journal

# generated / editor noise
src/generated
next-env.d.ts
tsconfig.tsbuildinfo
*.log
.DS_Store
Thumbs.db
.vscode
.idea

# vendored CMA engine — built as its own Railway service, not part of the app image
engine/
