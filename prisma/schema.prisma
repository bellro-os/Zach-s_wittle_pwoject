// compbird — standalone consumer app. Deliberately mirrors the SHAPE of the
// platform's auth trio (AuthUser / Account / Membership) so the ported server
// code (session context, usage metering, Stripe webhook) runs unchanged — but
// this is compbird's OWN database: no compliance models, no multi-seat teams,
// and a two-rung tier ladder (FREE trial → SOLO "Pro" $20/mo).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AccountTier {
  FREE
  SOLO
  ADMIN
}

model AuthUser {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String?
  name               String?
  isSuperAdmin       Boolean             @default(false)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  memberships        Membership[]
  verificationTokens VerificationToken[]
}

/// Single-use, short-lived tokens for out-of-band verification flows
/// (currently only kind="reset" — self-serve password reset). Only the
/// sha256 hash of the raw token is stored; the raw value lives solely in
/// the emailed (or dev-console-logged) link.
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  kind      String    // "reset"
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model Account {
  id                   String       @id @default(cuid())
  name                 String
  tier                 AccountTier  @default(FREE)
  /// JSON per-account entitlement override map (admin escape hatch).
  entitlementOverrides String       @default("{}")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  memberships          Membership[]
  usageEvents          UsageEvent[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  accountId String
  role      String   @default("OWNER")
  createdAt DateTime @default(now())
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
}

model UsageEvent {
  id        String   @id @default(cuid())
  accountId String
  feature   String
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, feature, createdAt])
}

/// One batch-valuation run ("cma.portfolio", SOLO+). Statuses are plain strings
/// (not enums) so they stay byte-identical to the wire contract in
/// src/lib/compbird/portfolio.ts: "running" | "done" | "failed".
model PortfolioRun {
  id        String          @id @default(cuid())
  accountId String
  userId    String
  status    String          @default("running")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     PortfolioItem[]

  @@index([accountId, createdAt])
}

/// One property inside a PortfolioRun. Result fields stay null until the batch
/// runner lands them; status: "pending" | "running" | "done" | "error".
model PortfolioItem {
  id              String       @id @default(cuid())
  runId           String
  position        Int
  label           String?
  inputAddress    String?
  inputParcelId   String?
  status          String       @default("pending")
  resolvedAddress String?
  parcelId        String?
  mid             Float?
  low             Float?
  high            Float?
  confidenceTier  String?
  caution         Boolean?
  compCount       Int?
  nearestMi       Float?
  avgMatch        Float?
  error           String?
  updatedAt       DateTime     @updatedAt
  run             PortfolioRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, position])
}
