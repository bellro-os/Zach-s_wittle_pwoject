DATABASE_URL=postgresql://mls:mls@localhost:5432/mls_bot

MLS_MODE=reso
MLS_RESO_BASE_URL=
MLS_RESO_TOKEN_URL=
MLS_RESO_CLIENT_ID=
MLS_RESO_CLIENT_SECRET=

MLS_RETS_LOGIN_URL=
MLS_RETS_USERNAME=
MLS_RETS_PASSWORD=
MLS_RETS_USER_AGENT=
MLS_RETS_UA_PASSWORD=

ASSESSOR_BASE=https://maps.montva.com/server/rest/services/Land/Parcels_Public/MapServer/1
ASSESSOR_JURISDICTION=BLACKSBURG

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_FROM=
DIGEST_TO=

ABSENTEE_MIN_TENURE_YEARS=10
ABSENTEE_MIN_EQUITY_RATIO=0.60

# --- AI accuracy layers (optional) ---------------------------------------
# When set, the CMA pipeline's optional AI layers light up:
#   Layer 1  comp-hygiene review (drops non-arms-length / wrong-type comps,
#            condition-adjusts the rest from MLS remarks) — `--ai-hygiene`
#            on `python -m tasks cma`, or the "AI comp review" toggle in the
#            dashboard.
#   Layer 2  natural-language property search ("renovated 4-bed near VT
#            under $800k") in the dashboard typeahead.
#   Layer 3  adversarial comp-set review shown in the dashboard preview.
# All three degrade to deterministic behaviour when this is blank — Layer 0
# (prior-sale anchor + time + size adjustments) always runs, no key needed.
ANTHROPIC_API_KEY=
