# Compbird — production environment (RAILWAY). There is no .env file in
# production: every value below is entered as a SERVICE VARIABLE in the Railway
# dashboard (app service and engine service are listed separately). This file
# is the documented mirror of those variables — keep it in lockstep with
# deploy/README.md §7. NEVER commit real values.
#
# NOTE: production is WORKER-ONLY. The dev-machine vars MLS_BOT_ROOT and
# PYTHON_BIN must stay UNSET on Railway — the Python spawn fallback does not
# exist there (no engine checkout inside the app image, no Python in it).
# Every engine call goes over HTTP to the `engine` service on the private
# mesh; if CMA_ENGINE_URL is unreachable, search/profile/preview/generate fail
# cleanly (no crash), so the engine service + token are REQUIRED for the app
# to actually function.

# ══════════════════════════════════════════════════════════════════════════════
# APP SERVICE (Railway service built from the Compbird repo)
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres (Railway managed database service in the same project). In the
# dashboard, reference the Postgres service's private connection string:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}   (host postgres.railway.internal)
# On first boot the entrypoint provisions the schema via deploy/apply-schema.mjs
# (the `pg` driver applies the build-generated prisma/schema.sql, guarded
# apply-if-fresh in a transaction — NOT the Prisma CLI). The /data volume now
# holds ONLY the address search index, not the app database.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# ── Sessions ─────────────────────────────────────────────────────────────────
# Signing secret for the cb_session cookie — its OWN realm (a Ratifyly session
# means nothing here; do NOT reuse Ratifyly's secret). Min 16 chars enforced;
# generate:  openssl rand -base64 48
SESSION_SECRET=

# ── Public origin (BUILD-TIME) ───────────────────────────────────────────────
# Canonical https origin: Stripe redirect/return URLs, emailed links, and the
# BUILD-time metadataBase + robots.txt + sitemap.xml + client bundles.
# NEXT_PUBLIC_* variables reach the Docker build as build args (the Dockerfile
# declares matching ARGs) — changing one requires a REDEPLOY, not a restart.
NEXT_PUBLIC_APP_URL=https://compbird.com
# Support inbox shown in the footer + error/signin copy. Build-time as above.
NEXT_PUBLIC_COMPBIRD_CONTACT_EMAIL=support@compbird.com

# ── CMA engine (the `engine` service, over Railway private networking) ───────
# Private-mesh hostname of the engine service. IPv6-only mesh — the engine
# binds CMA_WORKER_HOST=:: for this (see deploy/README.md §1). Code precedence:
# COMPBIRD_ENGINE_URL > CMA_ENGINE_URL > CMA_WORKER_URL > http://127.0.0.1:8765
# — see src/lib/cma/worker.ts.
CMA_ENGINE_URL=http://engine.railway.internal:8765
# Bearer token the app sends to the engine; set the SAME value on the engine
# service (it rejects unauthenticated calls). Generate:  openssl rand -hex 32
CMA_WORKER_TOKEN=
# Where the app streams generated CMA PDFs from. !! KNOWN GAP on Railway:
# volumes are NOT shareable between services, so the engine's outputs are not
# reachable as a filesystem path — leave this UNSET until the outputs-over-HTTP
# (or R2) change lands. See deploy/README.md "Known gaps #1".
# CMA_OUTPUTS_DIR=
# Prebuilt address-typeahead index (SQLite FTS5) on the APP volume — the
# data-sync kit delivers/refreshes it. Without it search errors (the Python
# fallback is absent in production).
SEARCH_INDEX_PATH=/data/search_index.sqlite
# The app boot (deploy/data-sync/entrypoint.app.sh) SEEDS that index from R2 via
# pull_and_swap.sh, so the APP service also needs the puller's R2 creds (same
# object store the engine pulls from). Unset ⇒ seed skipped + typeahead down.
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_BUCKET=compbird-engine-data
# R2_KEY=...
# R2_SECRET=...
# R2_PREFIX=          # optional key prefix, must match the push script
# Optional: re-pull the index every N hours (unset/0 = seed once at boot). On a
# changed index the container restarts to drop the cached search handle.
# SEARCH_INDEX_REFRESH_HOURS=
# Append-only audit trail for agent overrides — keep it on the volume.
COMPBIRD_OVERRIDES_PATH=/data/compbird-overrides.jsonl
# OPT-IN: price off the supplemental public-records pool instead of MLS. The
# path is as seen INSIDE THE ENGINE CONTAINER, not here.
# COMPBIRD_LISTINGS_PARQUET=/app/data/supplemental_listings.parquet
# Point compbird at a second engine instance instead (only if one is deployed):
# COMPBIRD_ENGINE_URL=http://compbird-engine.railway.internal:8765

# ── Injected by Railway (do NOT set) ─────────────────────────────────────────
# PORT — the standalone server listens on it.

# ── Stripe (compbird's OWN product: Pro $20/mo → SOLO tier) ──────────────────
# App boots + runs FREE-tier fine without these; billing routes surface a clean
# "not configured" error until set. Webhook endpoint to register in the Stripe
# dashboard: https://compbird.com/api/billing/webhook
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...            # the recurring $20/mo Pro price
# STRIPE_WEBHOOK_SECRET=whsec_...      # signing secret for /api/billing/webhook
# STRIPE_PRICE_ID_ANNUAL=price_...     # optional annual Pro price (also → SOLO)

# ── Email (Resend — password-reset links etc.) ───────────────────────────────
# Unset ⇒ sends are suppressed (logged) and flows fall back gracefully.
# RESEND_API_KEY=re_...
# MAIL_FROM="compbird <mail@compbird.com>"   # must be a Resend-verified sender

# ── Optional integrations ────────────────────────────────────────────────────
# Google Street View photos on reports; absent ⇒ the UI simply omits them.
# GOOGLE_MAPS_API_KEY=

# ── Ad pixels (Meta retargeting + Google Ads conversions) ────────────────────
# ALL optional — with none set, no pixel loads and the consent banner never
# shows. NEXT_PUBLIC_* values are BUILD-time (see above). Pixels only fire for
# visitors who accept the cookie banner; the webhook's server-side Meta event
# additionally requires the buyer to have consented at checkout time.
# NEXT_PUBLIC_META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN=
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=
# NEXT_PUBLIC_GOOGLE_ADS_SUBSCRIBE_LABEL=

# ══════════════════════════════════════════════════════════════════════════════
# ENGINE SERVICE (Railway service built from the "MLS Bot" repo)
# ══════════════════════════════════════════════════════════════════════════════

# Dual-stack bind — REQUIRED on Railway's IPv6-only private mesh (0.0.0.0 would
# bind but be unreachable at engine.railway.internal). Image default; set it
# explicitly for dashboard visibility.
CMA_WORKER_HOST=::
CMA_WORKER_PORT=8765
# Align Railway's port detection/healthcheck with the worker's port.
PORT=8765
# Same value as the app's CMA_WORKER_TOKEN above.
# CMA_WORKER_TOKEN=   (same as app)
# Per-request wall-clock budget (seconds) inside the worker — returns a
# 504-style error on a wedged Chromium render instead of hanging the worker.
CMA_WORKER_REQ_TIMEOUT=180
# In-engine Haiku comp-hygiene reviewer + the blind-ensemble valuer
# (CMA_BLIND_ENSEMBLE). REQUIRED — absent, valuations silently diverge from the
# certified accuracy posture (the entrypoint prints a loud warning).
ANTHROPIC_API_KEY=
# Optional engine model overrides (both default to Haiku in engine code):
# CMA_HYGIENE_MODEL=
# CMA_BLIND_MODEL=

# ── THE SIX PRODUCTION CMA FLAGS (compbird's certified engine posture) ────────
# Deliberate, launch-blocking configuration — NOT tunables. Baked as image
# defaults in deploy/Dockerfile.engine AND set as service variables so the
# dashboard shows the posture. Removing any one changes valuations or response
# serialization vs. what was certified.
CMA_COMP_SCORE_SURFACE=1
CMA_COMP_TUNING_DISCLOSURE=1
CMA_AVM_INDEX_DEBIAS=1
CMA_PRIOR_SALE_GUARDS=1
CMA_BLIND_ENSEMBLE=1
CMA_OVERRIDE_DAMPING=1

# Persistent AI caches — the entrypoint defaults both onto the volume
# (/data/cache/...); override only with volume paths.
# CMA_BLIND_CACHE=/data/cache/cma_blind_cache.json
# CMA_HYGIENE_CACHE=/data/cache/cma_hygiene_cache.json

# Injected by Railway (do NOT set): RAILWAY_VOLUME_MOUNT_PATH — the engine
# entrypoint reads it to lay out /data/{data,outputs,cache} and symlink them to
# /app/*. (ENGINE_VOLUME_ROOT is the manual equivalent for non-Railway runs.)

# R2/object-storage credentials for the in-container puller: owned by
# deploy/data-sync/ — see its README for the exact variable names.
