# deploy/ops/ops.env.example — ops-related env vars for the RAILWAY services.
# These are not a sourced env file anymore (that was the VPS/cron era): set
# them in the Railway dashboard per service (service -> Variables). This file
# is the reference for what to set where. Full context: deploy/ops/README.md.

# ══════════════════════════════════════════════════════════════════════════════
# Service "app" (Dockerfile.app) — Litestream continuous DB backup
# ══════════════════════════════════════════════════════════════════════════════
# Must equal DATABASE_URL's file: path (DATABASE_URL=file:/data/compbird.db).
LITESTREAM_DB_PATH=/data/compbird.db
# R2 replica URL. Create bucket `compbird-backups` in Cloudflare R2 first.
# <ACCOUNT_ID> = Cloudflare account id (R2 overview page). Unset => the
# entrypoint skips Litestream and starts node directly (WARN in logs).
LITESTREAM_REPLICA_URL=s3://compbird-backups/compbird/db?endpoint=<ACCOUNT_ID>.r2.cloudflarestorage.com&region=auto
# R2 API token pair (R2 -> Manage API Tokens -> Object Read & Write, scoped to
# ONLY the backups bucket).
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# -- fallback-backup.sh only (NOT needed while Litestream is on) --------------
# DB_PATH=/data/compbird.db
# BACKUP_DIR=/data/backups
# KEEP=7
# R2_BUCKET=compbird-backups
# R2_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PREFIX=compbird/fallback
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# ══════════════════════════════════════════════════════════════════════════════
# Service "engine" (Dockerfile.engine) — freshness watchdog (freshness-check.sh)
# ══════════════════════════════════════════════════════════════════════════════
# Where the data-sync puller touches the success marker.
DATA_DIR=/app/data
# Page when the marker is older than this (minutes). Data refresh is hourly;
# 120 = one fully missed cycle + slack, catches a dead chain within ~2h.
FRESHNESS_MAX_AGE_MIN=120
# Generic alert webhook: Slack incoming webhook, Discord webhook, or an ntfy
# topic URL (https://ntfy.sh/<random-topic>). Unset => alerts print to the
# container log only — fine for a dry run, useless for 3am pages.
WEBHOOK_URL=
# auto sniffs slack/discord from the URL; ntfy and anything else gets raw text.
WEBHOOK_FORMAT=auto
# Optional healthchecks.io check URL — the loop pings it every cycle while
# fresh; the ping STOPPING alerts (dead-man switch). This is what tells you
# "the engine container itself is gone" without exposing the engine publicly.
PING_URL=
# Re-alert cadence while stale, minutes.
COOLDOWN_MIN=30
HOST_LABEL=compbird-engine

# ══════════════════════════════════════════════════════════════════════════════
# External (no Railway env at all)
# ══════════════════════════════════════════════════════════════════════════════
# UptimeRobot (or any HTTP prober): register  https://compbird.com/api/health
#   -> alert on non-200. 1-5 min interval. See README "Uptime monitoring".
# healthchecks.io: create check "compbird-engine-data", period 10 min,
#   grace 30 min -> paste its ping URL into PING_URL above.
