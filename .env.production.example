# Compbird — production environment (VPS). Copy to .env.production next to the
# repo root on the VPS, fill in real values, chmod 600. NEVER commit the real file.
# Compose wires it in via `env_file: .env.production` (see deploy/docker-compose.compbird.yml).
#
# NOTE: production is WORKER-ONLY. The dev-machine vars MLS_BOT_ROOT and
# PYTHON_BIN must stay UNSET here — the Python spawn fallback does not exist on
# the VPS (no engine checkout, no Python in the image). Every engine call goes
# over HTTP to the existing Ratifyly engine container; if CMA_ENGINE_URL is
# unreachable, search/profile/preview/generate fail cleanly (no crash), so the
# engine URL + token + the two read-only volume mounts are REQUIRED for the app
# to actually function.

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite on the persistent named volume (compbird-data:/data). The entrypoint
# runs `prisma db push` against it on every boot (creates the file first boot).
DATABASE_URL=file:/data/compbird.db

# ── Sessions ─────────────────────────────────────────────────────────────────
# Signing secret for the cb_session cookie — its OWN realm (a Ratifyly session
# means nothing here; do NOT reuse Ratifyly's secret). Min 16 chars enforced;
# generate:  openssl rand -base64 48
SESSION_SECRET=

# ── Public origin ────────────────────────────────────────────────────────────
# Canonical https origin. Used at RUNTIME for Stripe redirect/return URLs and
# emailed links, and at BUILD time for metadataBase + robots.txt + sitemap.xml
# and any client-bundle usage — so it is ALSO passed as a Docker build arg
# (compose build.args reads it from the shell env; run compose with
# `--env-file .env.production` from the repo root so both paths see it).
NEXT_PUBLIC_APP_URL=https://compbird.com

# Support inbox shown in the footer + error/signin copy. Client-bundle value ⇒
# BUILD-time (same build-arg mechanism as above).
NEXT_PUBLIC_COMPBIRD_CONTACT_EMAIL=support@compbird.com

# ── CMA engine (the ONE shared piece with the Ratifyly stack) ────────────────
# The warm worker inside the existing `engine` container, reached by compose
# service name. (Code precedence: COMPBIRD_ENGINE_URL > CMA_ENGINE_URL >
# CMA_WORKER_URL > http://127.0.0.1:8765 — see src/lib/cma/worker.ts. Use
# CMA_ENGINE_URL, same var the Ratifyly app uses.)
CMA_ENGINE_URL=http://engine:8765
# Shared bearer token — MUST MATCH the CMA_WORKER_TOKEN in the ratifyly stack's
# .env (the engine rejects calls without it).
CMA_WORKER_TOKEN=
# Where the engine writes generated CMA PDFs — the ratifyly engine-outputs
# volume, mounted READ-ONLY into this container (see compose). /api/compbird/pdf
# streams report downloads from here; without it every download 404s.
CMA_OUTPUTS_DIR=/app/engine-outputs
# Prebuilt address-typeahead index (SQLite FTS5) on the ratifyly engine-data
# volume, mounted READ-ONLY. Without it search errors — the Python fallback is
# absent in production.
SEARCH_INDEX_PATH=/app/engine-data/search_index.sqlite
# Append-only audit trail for agent overrides — keep it on the persistent
# volume (the in-image default path is ephemeral).
COMPBIRD_OVERRIDES_PATH=/data/compbird-overrides.jsonl
# OPT-IN: price off the supplemental public-records pool instead of MLS. The
# path is as seen INSIDE THE ENGINE CONTAINER (engine-data volume), not here.
# COMPBIRD_LISTINGS_PARQUET=/app/data/supplemental_listings.parquet
# Point compbird at its OWN engine instance instead of the shared one (only if
# a second engine service is deployed):
# COMPBIRD_ENGINE_URL=http://compbird-engine:8765

# ── Stripe (compbird's OWN product: Pro $20/mo → SOLO tier) ──────────────────
# App boots + runs FREE-tier fine without these; billing routes surface a clean
# "not configured" error until set. Webhook endpoint to register in the Stripe
# dashboard: https://compbird.com/api/billing/webhook
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...            # the recurring $20/mo Pro price
# STRIPE_WEBHOOK_SECRET=whsec_...      # signing secret for /api/billing/webhook
# STRIPE_PRICE_ID_ANNUAL=price_...     # optional annual Pro price (also → SOLO)

# ── Email (Resend — password-reset links etc.) ───────────────────────────────
# Unset ⇒ sends are suppressed (logged) and flows fall back gracefully; being
# wired up separately — reserve the values here.
# RESEND_API_KEY=re_...
# MAIL_FROM="compbird <mail@compbird.com>"   # must be a Resend-verified sender

# ── Optional integrations ────────────────────────────────────────────────────
# Google Street View photos on reports; absent ⇒ the UI simply omits them.
# GOOGLE_MAPS_API_KEY=
