# Compbird vhost — APPEND this block to the existing Ratifyly Caddyfile on the
# VPS (the one mounted into the caddy service at /etc/caddy/Caddyfile), then
# reload:  docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
# (or `docker compose restart caddy`).
#
# DNS first: A records for compbird.com AND www.compbird.com → the VPS IP.
# Caddy auto-provisions + renews TLS once DNS resolves.
#
# {$COMPBIRD_DOMAIN:compbird.com} reads the COMPBIRD_DOMAIN env var from the
# caddy CONTAINER (add `COMPBIRD_DOMAIN: "compbird.com"` under the caddy
# service's `environment:` to override) and falls back to compbird.com.
# Simplest path: just replace the placeholders with your literal domain.

# Canonical host: apex. www redirects so cookies/TLS have one origin.
www.{$COMPBIRD_DOMAIN:compbird.com} {
	redir https://{$COMPBIRD_DOMAIN:compbird.com}{uri} permanent
}

{$COMPBIRD_DOMAIN:compbird.com} {
	# `compbird` = the compose service name; both containers must share a
	# network (automatic in merge mode, external network in standalone mode).
	reverse_proxy compbird:3000

	encode zstd gzip

	# ── Security headers (mirrors the proven Ratifyly vhost) ──────────────────
	header {
		# Force HTTPS for a year, cover subdomains, allow HSTS preload listing.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Stop MIME sniffing (blocks a class of XSS via content-type confusion).
		X-Content-Type-Options "nosniff"
		# Disallow framing entirely — clickjacking defense.
		X-Frame-Options "DENY"
		# Send origin only cross-site; strip path/query from the Referer.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Conservative feature policy: deny high-risk sensors/APIs by default.
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()"
		# Strip the framework/version leak.
		-X-Powered-By
	}
}
